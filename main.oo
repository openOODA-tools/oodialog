// # oodialog Main Entry Point
//
// Logline: Sovereign terminal modal dialogue and input box interface engine with dual-surface CLI and MCP stdio interfaces.
//
// Setup: Demands &FsReadCap, &ProcessCap, and &EnvCap tokens for capability-bounded modal execution.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, or --mcp.
//   2. Dispatch interactive and demonstration modal showcase when --demo is specified.
//   3. Render configured dialog modal box to standard output or JSON stream.
//   4. Deliver appropriate POSIX exit code matching widget decisions.

import "core/dialog_demo.oo";
import "render/dialog_view.oo";
import "render/dialog_json.oo";
import "ipc/dialog_opts.oo";
import "ipc/mcp_serve.oo";
import "anchor.oo";

fn main(
    fr: &FsReadCap,
    pr: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Int {
    let act: CliAction = parse_cli_args(args);

    if act.show_help {
        print_help();
        return 0;
    }

    if act.show_version {
        print_version();
        return 0;
    }

    if act.is_mcp {
        run_mcp_server(fr);
        return 0;
    }

    if act.run_test {
        if !run_all_tests() {
            println("oodialog: internal anchor tests FAILED");
            return 1;
        }
        println("oodialog: internal anchor tests PASSED");
        return 0;
    }

    if act.config.demo_mode {
        if act.config.json_output {
            print(demo_to_json() + "\n");
        } else {
            print(build_demo_document());
        }
        return 0;
    }

    if act.config.json_output {
        print(config_to_json(act.config, act.items) + "\n");
        return 0;
    }

    let rendered: String = render_view(act.config, act.items);
    print(rendered);

    if act.config.kind == "yesno" && act.config.default_no {
        return 1;
    }

    return 0;
}
