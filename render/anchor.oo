// # oodialog Render Subsystem Test Harness
//
// Logline: In-memory verification suite validating ANSI theme palettes, terminal view composition, and JSON serialization.
//
// Setup: Demands no ambient authority; exercises rendering and formatting routines in memory.
//
// Beats:
//   1. Verify theme color escape sequences and button highlight formatting.
//   2. Verify backtitle header bar rendering and canvas frame composition.
//   3. Verify JSON serialization for menu items, dialog configs, and results.
//   4. Deliver unified render test runner returning boolean status.

import "core/dialog_types.oo";
import "core/dialog_demo.oo";
import "render/dialog_theme.oo";
import "render/dialog_view.oo";
import "render/dialog_json.oo";

fn test_themes() -> Bool {
    let r: String = color_reset();
    if r != "\x1b[0m" {
        return false;
    }
    let border: String = theme_border("ember");
    if chars_len(border) == 0 {
        return false;
    }
    let btn: String = theme_btn_active("ocean");
    if !str_contains(btn, "\x1b[1;30;46m") {
        return false;
    }
    let back: String = theme_backtitle("ember");
    if !str_contains(back, "\x1b[1;37;41m") {
        return false;
    }
    return true;
}

fn test_views() -> Bool {
    let bar: String = render_backtitle_bar("MY ADMIN REALM", "ember", 80);
    if !str_contains(bar, "MY ADMIN REALM") {
        return false;
    }

    let mut cfg: DialogConfig = default_dialog_config();
    cfg.title = "VIEW TEST";
    cfg.text = "Testing canvas layout view rendering.";
    let view: String = render_view(cfg, list_new());
    if !str_contains(view, "VIEW TEST") || !str_contains(view, "<  OK  >") {
        return false;
    }

    return true;
}

fn test_json() -> Bool {
    let mut cfg: DialogConfig = default_dialog_config();
    cfg.title = "PROMPT";
    cfg.text = "Do you agree?";
    let items: List[MenuItem] = build_demo_menu_items();

    let c_json: String = config_to_json(cfg, items);
    if !str_contains(c_json, "\"title\":\"PROMPT\"") || !str_contains(c_json, "Network Interface") {
        return false;
    }

    let mut sel: List[String] = list_new();
    sel = list_push(sel, "TAG_A");
    let res: DialogResult = DialogResult { exit_code: 0, text_out: "Accepted", selected_tags: sel };
    let r_json: String = result_to_json(res);
    if !str_contains(r_json, "\"exit_code\":0") || !str_contains(r_json, "\"TAG_A\"") {
        return false;
    }

    let d_json: String = demo_to_json();
    if !str_contains(d_json, "\"tool\":\"oodialog\"") || !str_contains(d_json, "msgbox") {
        return false;
    }

    return true;
}

pub fn run_render_tests() -> Bool {
    print("Running oodialog render tests...\n");
    if !test_themes() {
        print("  FAIL: themes test\n");
        return false;
    }
    print("  ✓ themes tests passed\n");

    if !test_views() {
        print("  FAIL: views test\n");
        return false;
    }
    print("  ✓ views tests passed\n");

    if !test_json() {
        print("  FAIL: json test\n");
        return false;
    }
    print("  ✓ json tests passed\n");

    return true;
}
