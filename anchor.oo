// # oodialog Root Verification Anchor
//
// Logline: Unified test runner aggregating verification anchors from core, render, and ipc subsystems.
//
// Setup: Demands no ambient authority; invokes deterministic subsystem test routines.
//
// Beats:
//   1. Execute core types, box layout, modal engine, and demo checks.
//   2. Execute render theme palettes, canvas views, and JSON serialization tests.
//   3. Execute ipc CLI argument parsing, JSON field extraction, and MCP protocol tests.
//   4. Return aggregate boolean test result.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    println("=== Starting oodialog Full Test Suite ===");
    if !run_core_tests() {
        println("FAIL: core tests failed");
        return false;
    }
    if !run_render_tests() {
        println("FAIL: render tests failed");
        return false;
    }
    if !run_ipc_tests() {
        println("FAIL: ipc tests failed");
        return false;
    }
    println("=== All oodialog Subsystems Verified Clean ===");
    return true;
}
